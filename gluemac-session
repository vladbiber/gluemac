#!/bin/sh
# gluemac-session: what the display manager runs (or what you run from a TTY).
# It seeds the config, finds the right D-Bus session, gets audio going and
# then runs the compositor with its stderr kept in ~/.local/state/gluemac.log.

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=gluemac
export XDG_CURRENT_DESKTOP=gluemac

CFGDIR="${XDG_CONFIG_HOME:-$HOME/.config}/gluemac"
if [ ! -e "$CFGDIR/config.conf" ]; then
	mkdir -p "$CFGDIR"
	# The prefix this script was installed under comes first, so a custom
	# --prefix and a Nix store path find their own default config; the fixed
	# paths keep working for anything that puts the script elsewhere.
	SELFDIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd || true)
	for dir in ${GLUEMAC_DATADIR:+"$GLUEMAC_DATADIR"} \
			${SELFDIR:+"$SELFDIR/../share/gluemac"} \
			/usr/local/share/gluemac /usr/share/gluemac; do
		if [ -r "$dir/config.def.conf" ]; then
			cp "$dir/config.def.conf" "$CFGDIR/config.conf"
			break
		fi
	done
fi

RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# D-Bus.  On a systemd (or dbus-broker) system the user bus is already up at
# $XDG_RUNTIME_DIR/bus and everything else - pipewire, the portals, the
# notification daemon - lives on it.  Starting a second bus with
# dbus-run-session here would split the desktop in two: the apps started by
# the compositor on one bus, the services on the other, and nothing finds
# anything.  So the existing bus is used when there is one, and
# dbus-run-session is only the fallback for systems without a user bus.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
	if [ -S "$RUNDIR/bus" ]; then
		DBUS_SESSION_BUS_ADDRESS="unix:path=$RUNDIR/bus"
		export DBUS_SESSION_BUS_ADDRESS
	elif command -v dbus-run-session >/dev/null 2>&1; then
		exec dbus-run-session -- "$0" "$@"
	fi
fi

LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$LOGDIR/gluemac.log"
AUDIOLOG="$LOGDIR/gluemac-audio.log"
mkdir -p "$LOGDIR"
mv -f "$LOG" "$LOG.old" 2>/dev/null
ulimit -c unlimited 2>/dev/null

# Audio.  Where systemd manages the user session (Arch, Fedora, Debian...)
# the PipeWire units are the right thing to use: starting the daemons by
# hand next to the sockets systemd already listens on gives two of each and a
# broken graph.  Everywhere else the daemons are started here, in order, and
# kept alive for as long as the session lasts: a PipeWire that dies takes the
# sound with it until logout otherwise.
has_user_systemd() {
	command -v systemctl >/dev/null 2>&1 \
		&& [ -d /run/systemd/system ] \
		&& systemctl --user show-environment >/dev/null 2>&1
}

AUDIO_SUPERVISOR=
if has_user_systemd; then
	systemctl --user import-environment XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
		XDG_CURRENT_DESKTOP >/dev/null 2>&1
	for unit in pipewire.socket pipewire-pulse.socket wireplumber.service; do
		systemctl --user start "$unit" >/dev/null 2>&1
	done
else
	# The daemons that are not running yet are ours to start and restart; one
	# that was already there (another session, a system-wide setup) is left
	# alone.  Restarts are rate limited so a daemon that cannot start at all
	# does not spin.
	supervise_audio() {
		uid=$(id -u)
		: > "$AUDIOLOG"
		pw_pid= wp_pid= pp_pid=
		pw_own=0 wp_own=0 pp_own=0
		restarts=0
		window=$(date +%s)
		start_daemon() {
			# $1 = command, $2 = variable prefix
			"$1" >>"$AUDIOLOG" 2>&1 &
			eval "${2}_pid=$!"
			eval "${2}_own=1"
		}
		want() {
			command -v "$1" >/dev/null 2>&1 || return 1
			! pgrep -u "$uid" -x "$1" >/dev/null 2>&1
		}
		want pipewire && start_daemon pipewire pw
		sleep 0.3
		want wireplumber && start_daemon wireplumber wp
		want pipewire-pulse && start_daemon pipewire-pulse pp
		while kill -0 "$GLUEMAC_PID" 2>/dev/null; do
			sleep 2
			now=$(date +%s)
			if [ $((now - window)) -ge 60 ]; then
				window=$now
				restarts=0
			fi
			[ "$restarts" -lt 5 ] || continue
			for d in pw wp pp; do
				eval "own=\$${d}_own; pid=\$${d}_pid"
				[ "$own" -eq 1 ] || continue
				kill -0 "$pid" 2>/dev/null && continue
				case $d in
				pw) cmd=pipewire ;;
				wp) cmd=wireplumber ;;
				pp) cmd=pipewire-pulse ;;
				esac
				printf '%s: %s exited, starting it again\n' "$(date)" "$cmd" >>"$AUDIOLOG"
				restarts=$((restarts + 1))
				start_daemon "$cmd" "$d"
				sleep 0.3
			done
		done
	}
fi

# Window buttons on the left, as on a Mac, for GTK apps. The setting is the
# user's own and other desktops read it too, so it is put back on the way out.
BUTTONS_KEY="org.gnome.desktop.wm.preferences button-layout"
BUTTONS_WAS=
if command -v gsettings >/dev/null 2>&1; then
	BUTTONS_WAS=$(gsettings get $BUTTONS_KEY 2>/dev/null)
	gsettings set $BUTTONS_KEY 'close,minimize,maximize:' 2>/dev/null
fi

# Mac-coloured window buttons for GTK 3 and 4, a marked block in the user's
# gtk.css that comes out again on the way out
GTKCSS_SRC=
for f in "$(dirname "$0")/../share/gluemac/gluemac-gtk.css" /usr/local/share/gluemac/gluemac-gtk.css /usr/share/gluemac/gluemac-gtk.css; do
	[ -r "$f" ] && { GTKCSS_SRC=$f; break; }
done
gtkcss_strip() {
	for v in 3.0 4.0; do
		c="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$v/gtk.css"
		[ -f "$c" ] && sed -i '/\/\* gluemac traffic lights \*\//,/\/\* end gluemac traffic lights \*\//d' "$c"
	done
}
gtkcss_strip
if [ -n "$GTKCSS_SRC" ]; then
	for v in 3.0 4.0; do
		d="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$v"
		mkdir -p "$d" && cat "$GTKCSS_SRC" >>"$d/gtk.css"
	done
fi

{
	printf '== gluemac session %s ==\n' "$(date)"
	printf 'D-Bus: %s\n' "${DBUS_SESSION_BUS_ADDRESS:-none}"
	gluemac "$@" &
	GLUEMAC_PID=$!
	if [ -z "$AUDIO_SUPERVISOR" ] && ! has_user_systemd; then
		supervise_audio &
		AUDIO_SUPERVISOR=$!
	fi
	wait "$GLUEMAC_PID"
	status=$?
	[ -n "$AUDIO_SUPERVISOR" ] && kill "$AUDIO_SUPERVISOR" 2>/dev/null
	[ -n "$BUTTONS_WAS" ] && gsettings set $BUTTONS_KEY "$BUTTONS_WAS" 2>/dev/null
	gtkcss_strip
	printf '== gluemac exited status=%s %s ==\n' "$status" "$(date)"
	sync 2>/dev/null
	exit "$status"
} >>"$LOG" 2>&1
